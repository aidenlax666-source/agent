# ===== AI - DeepSeek（文本大脑，必填）=====
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_KEYS=                    # 多 key 逗号分隔，自动负载均衡 + 限流退避
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_MODEL_REASONING=deepseek-reasoner  # 复杂任务/修复用推理模型
DEV_MODIFY_MODEL=                     # 开发改码主生成模型（空=AI_MODEL，deepseek-chat 快；可设 deepseek-reasoner 更稳）

# ===== 可选 LLM 提供商（想用别的模型时切换；默认 deepseek）=====
# llm_provider 可选：deepseek | openai | anthropic | ollama | custom
LLM_PROVIDER=deepseek
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Ollama（本地，OpenAI 兼容端点）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
# 自定义 OpenAI 兼容服务（OneAPI/LiteLLM 等）
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_KEY=
CUSTOM_OPENAI_MODEL=

# ===== AI - 豆包/火山方舟（可选，多模态：视觉识别/视频/图片）=====
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION_MODEL=doubao-seed-1-6-vision-250815
DOUBAO_TTS_API_KEY=                   # 火山引擎语音控制台 key（与方舟 ark- 不同）
DOUBAO_TTS_VOICE=zh_female_shuangkuaisisi_uranus_bigtts

# ===== 反爬适配域名（逗号分隔，这些站点走"有头+人速+验证码等待"模式）=====
ANTI_BOT_DOMAINS=xiaohongshu.com,zhihu.com,weibo.com,douban.com,taobao.com,jd.com

# ===== 沙箱 =====
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT=60
SANDBOX_MAX_TIMEOUT=1800              # 单次执行总超时上限（秒）
SANDBOX_INACTIVITY_TIMEOUT=120        # 无输出判定卡死（秒）
SANDBOX_MAX_CONCURRENCY=3
SANDBOX_ALLOW_SUBPROCESS=true         # false 时禁止脚本 import subprocess/socket 等
SANDBOX_HEADFUL=true                  # 有头浏览器（反爬通过率高）/ false=无头

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== App =====
APP_ENV=development
DEBUG=true
# 前端来源（逗号分隔）+ localhost 任意端口自动放行
CORS_ORIGINS=http://localhost:3000
# 可信代理 IP（仅这些来源时信任 X-Forwarded-For）
TRUSTED_PROXY_IPS=127.0.0.1,::1
# 产物页连接的 API 域（与产物静态服务不同源，防同源 XSS）
PUBLIC_API_BASE=http://localhost:8000
# 产物/上传文件清理（天）：0=不清理，>0 时每天清理超期文件
ASSET_CLEANUP_DAYS=0
